diff --git a/solr/bin/solr b/solr/bin/solr
index 599fa1c6ff..c317933e4d 100755
--- a/solr/bin/solr
+++ b/solr/bin/solr
@@ -1329,7 +1329,7 @@ function start_solr() {
     "${SOLR_HOST_ADVERTISE_ARG[@]}" "-Duser.timezone=$SOLR_TIMEZONE" "-XX:-OmitStackTraceInFastThrow" \
     # '+ExitOnOutOfMemoryError' ensures that Solr exits whenever OOME is thrown, with a non-zero exit
