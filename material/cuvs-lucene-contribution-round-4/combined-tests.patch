+          doc.add(new StringField("id", Integer.toString(i), Field.Store.YES));
+          doc.add(new StringField("allowed", i >= firstMatching ? "yes" : "no", Field.Store.NO));
+          doc.add(
+              new KnnFloatVectorField(
+                  FIELD, new float[] {i, i}, VectorSimilarityFunction.EUCLIDEAN));
+          w.addDocument(doc);
+        }
+        w.commit();
+        for (int i = 0; i < deletedCount; i++) {
+          w.deleteDocuments(new Term("id", Integer.toString(i)));
+        }
+        w.commit();
+      }
+
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        assertEquals(1, reader.leaves().size());
+        assertEquals(100 - deletedCount, reader.numDocs());
+        assertEquals(deletedCount > 0, reader.hasDeletions());
+        Query filter = filtered ? new TermQuery(new Term("allowed", "yes")) : null;
