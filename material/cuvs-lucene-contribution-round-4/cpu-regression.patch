+  private void assertAcceptedDocuments(boolean filtered, int deletedCount) throws Exception {
+    int k = 5;
+    int firstMatching = filtered ? 40 : 0;
+    try (Directory dir = newDirectory()) {
+      IndexWriterConfig cfg = new IndexWriterConfig().setMergePolicy(NoMergePolicy.INSTANCE);
+      try (IndexWriter w = new IndexWriter(dir, cfg)) {
+        for (int i = 0; i < 100; i++) {
+          Document doc = new Document();
+          doc.add(new StringField("id", Integer.toString(i), Field.Store.YES));
+          doc.add(new StringField("allowed", i >= firstMatching ? "yes" : "no", Field.Store.NO));
+          doc.add(
+              new KnnFloatVectorField(
+                  FIELD, new float[] {i, i}, VectorSimilarityFunction.EUCLIDEAN));
+          w.addDocument(doc);
+        }
+        w.commit();
+        for (int i = 0; i < deletedCount; i++) {
+          w.deleteDocuments(new Term("id", Integer.toString(i)));
+        }
+        w.commit();
+      }
+
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        assertEquals(1, reader.leaves().size());
+        assertEquals(100 - deletedCount, reader.numDocs());
+        assertEquals(deletedCount > 0, reader.hasDeletions());
+        Query filter = filtered ? new TermQuery(new Term("allowed", "yes")) : null;
+        CountingQuery query = new CountingQuery(new float[] {0f, 0f}, k, filter);
+        TopDocs hits = new IndexSearcher(reader).search(query, k);
+
+        // There are far more accepted documents than k. Require the approximate adapter to run;
+        // the direct call below also prevents exact-search fallback from masking a regression.
+        assertEquals("segment searches", 1, query.searches.get());
+        assertAcceptedHits(reader, hits, k, firstMatching, deletedCount);
+
+        // Rewrite can rerun a segment exactly and conceal a dropped approximate-search mask.
+        // Also call the adapter directly so this test distinguishes correct forwarding from that
+        // successful fallback. One segment keeps these document IDs equal to the segment ordinals.
+        FixedBitSet acceptDocs = new FixedBitSet(reader.maxDoc());
+        acceptDocs.set(Math.max(firstMatching, deletedCount), reader.maxDoc());
+        TopDocs directHits =
+            TestLuceneCompat.approximateSearch(
+                query, reader.leaves().getFirst(), acceptDocs, Integer.MAX_VALUE);
+        assertEquals("segment searches", 2, query.searches.get());
+        assertAcceptedHits(reader, directHits, k, firstMatching, deletedCount);
+      }
+    }
+  }
+
+  private void assertAcceptedHits(
+      DirectoryReader reader, TopDocs hits, int k, int firstMatching, int deletedCount)
+      throws Exception {
+    assertEquals(k, hits.scoreDocs.length);
+    for (ScoreDoc hit : hits.scoreDocs) {
+      int id = Integer.parseInt(reader.storedFields().document(hit.doc).get("id"));
+      assertTrue("filtered document returned: " + id, id >= firstMatching);
+      assertTrue("deleted document returned: " + id, id >= deletedCount);
+    }
+  }
