+  public void testScratchReadOnlySolrHome() throws Exception {
+    assumeWorkingMockito();
+    Path solrHome = createTempDir("scratchRo");
+    Path securityJson = solrHome.resolve("security.json");
+    Files.write(securityJson, Utils.toJSON(shortSecurityData("seed")));
+    byte[] before = Files.readAllBytes(securityJson);
+    CoreContainer cc = mock(CoreContainer.class);
+    when(cc.getSolrHome()).thenReturn(solrHome);
+    SecurityConfHandlerLocalForTesting handler = new SecurityConfHandlerLocalForTesting(cc);
+    Files.setPosixFilePermissions(
+        solrHome, PosixFilePermissions.fromString("r-xr-xr-x"));
+    try {
+      try {
+        handler.persistConf(new SecurityConfig().setData(longSecurityData()));
+        System.out.println("SCRATCH-RO persistConf=succeeded");
+      } catch (Exception e) {
+        System.out.println(
+            "SCRATCH-RO persistConf=" + e + " cause=" + e.getCause());
+      }
+    } finally {
+      Files.setPosixFilePermissions(solrHome, PosixFilePermissions.fromString("rwxr-xr-x"));
+    }
+    System.out.println(
+        "SCRATCH-RO security.json unchanged=" + Arrays.equals(before, Files.readAllBytes(securityJson)));
+  }
