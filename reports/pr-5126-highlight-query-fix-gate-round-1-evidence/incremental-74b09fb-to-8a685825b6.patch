From 23c159d06bd86180e0bbd4b474517b60b693f926 Mon Sep 17 00:00:00 2001
From: Nick Shanin <nick.boss.us@gmail.com>
Date: Sun, 25 Oct 2026 13:33:14 -0400
Subject: [PATCH 1/2] SOLR-3479: use the search parser highlight query for
 inline snippets

---
 .../transform/HighlightAugmenterFactory.java  | 21 ++++-
 .../TestHighlightAugmenterFactory.java        | 83 +++++++++++++++++++
 2 files changed, 103 insertions(+), 1 deletion(-)

diff --git a/solr/core/src/java/org/apache/solr/response/transform/HighlightAugmenterFactory.java b/solr/core/src/java/org/apache/solr/response/transform/HighlightAugmenterFactory.java
index 5c27054189..9716bb2c1c 100644
--- a/solr/core/src/java/org/apache/solr/response/transform/HighlightAugmenterFactory.java
+++ b/solr/core/src/java/org/apache/solr/response/transform/HighlightAugmenterFactory.java
@@ -35,9 +35,11 @@ import org.apache.solr.common.SolrException.ErrorCode;
 import org.apache.solr.common.params.HighlightParams;
 import org.apache.solr.common.params.ModifiableSolrParams;
 import org.apache.solr.common.params.SolrParams;
+import org.apache.solr.handler.component.ResponseBuilder;
 import org.apache.solr.highlight.UnifiedSolrHighlighter;
 import org.apache.solr.highlight.UnifiedSolrHighlighter.SolrExtendedUnifiedHighlighter;
 import org.apache.solr.request.SolrQueryRequest;
+import org.apache.solr.request.SolrRequestInfo;
 import org.apache.solr.response.ResultContext;
 import org.apache.solr.schema.SchemaField;
 import org.apache.solr.search.DocIterationInfo;
@@ -177,7 +179,7 @@ public class HighlightAugmenterFactory extends TransformerFactory {
     @Override
     public void setContext(ResultContext context) {
       super.setContext(context);
-      Query query = hlQuery != null ? hlQuery : context.getQuery();
+      Query query = hlQuery != null ? hlQuery : getMainHighlightQuery(context);
       SolrIndexSearcher searcher = context.getSearcher();
       highlighter =
           (query == null || searcher == null)
@@ -185,6 +187,23 @@ public class HighlightAugmenterFactory extends TransformerFactory {
               : new SingleFieldHighlighter(searcher, params, field, query);
     }
 
+    private static Query getMainHighlightQuery(ResultContext context) {
+      SolrRequestInfo info = SolrRequestInfo.getRequestInfo();
+      ResponseBuilder rb = info == null ? null : info.getResponseBuilder();
+      // A custom result context may have a different query from the current request.
+      if (rb == null
+          || rb.req != context.getRequest()
+          || rb.getQuery() != context.getQuery()
+          || rb.getQparser() == null) {
+        return context.getQuery();
+      }
+      try {
+        return rb.getQparser().getHighlightQuery();
+      } catch (SyntaxError e) {
+        throw new SolrException(ErrorCode.BAD_REQUEST, e);
+      }
+    }
+
     @Override
     public void transform(SolrDocument doc, int docid, DocIterationInfo docInfo)
         throws IOException {
diff --git a/solr/core/src/test/org/apache/solr/response/transform/TestHighlightAugmenterFactory.java b/solr/core/src/test/org/apache/solr/response/transform/TestHighlightAugmenterFactory.java
index 9ecd03a453..fc49fa06f0 100644
--- a/solr/core/src/test/org/apache/solr/response/transform/TestHighlightAugmenterFactory.java
+++ b/solr/core/src/test/org/apache/solr/response/transform/TestHighlightAugmenterFactory.java
@@ -20,6 +20,7 @@ import java.util.List;
 import org.apache.solr.SolrTestCase;
 import org.apache.solr.client.solrj.SolrClient;
 import org.apache.solr.client.solrj.request.SolrQuery;
+import org.apache.solr.client.solrj.response.QueryResponse;
 import org.apache.solr.common.SolrDocument;
 import org.apache.solr.common.SolrException;
 import org.apache.solr.common.SolrInputDocument;
@@ -160,6 +161,88 @@ public class TestHighlightAugmenterFactory extends SolrTestCase {
     assertEquals("*Fox* story", docs.getFirst().getFieldValue("title_t"));
   }
 
+  private static ModifiableSolrParams boostedQuery(boolean weightMatches) {
+    ModifiableSolrParams params = new ModifiableSolrParams();
+    params.set("q", "fox");
+    params.set("defType", "edismax");
+    params.set("qf", "body_t title_t");
+    params.set("bq", "body_t:cats");
+    params.set("fl", "id,body_hl:[hl f=body_t]");
+    params.set("sort", "id asc");
+    params.set("hl.weightMatches", weightMatches);
+    params.set("hl.defaultSummary", false);
+    params.set("hl.method", "unified");
+    params.set("hl.fl", "body_t");
+    return params;
+  }
+
+  private static void assertOnlyUserQueryHighlighted(QueryResponse response) {
+    List<SolrDocument> docs = response.getResults();
+    assertEquals(2, docs.size());
+    assertEquals("1", docs.getFirst().getFieldValue("id"));
+    assertEquals("2", docs.get(1).getFieldValue("id"));
+    assertContains("<em>fox</em>", docs.getFirst().getFieldValue("body_hl"));
+    assertFalse(
+        "Boost-only text must not be highlighted: " + docs.get(1),
+        docs.get(1).containsKey("body_hl"));
+    if (response.getHighlighting() != null) {
+      var highlights = response.getHighlighting().get("2");
+      assertTrue(String.valueOf(highlights), highlights == null || highlights.isEmpty());
+    }
+  }
+
+  @Test
+  public void testImplicitQueryUsesHighlightQuery() throws Exception {
+    for (boolean weightMatches : List.of(true, false)) {
+      for (boolean component : List.of(false, true)) {
+        ModifiableSolrParams params = boostedQuery(weightMatches);
+        params.set("hl", component);
+        assertOnlyUserQueryHighlighted(solrTestRule.getSolrClient().query(params));
+
+        params.set("hl.q", "fox");
+        assertOnlyUserQueryHighlighted(solrTestRule.getSolrClient().query(params));
+
+        params.remove("hl.q");
+        params.set("fl", "id,body_hl:[hl f=body_t q=fox]");
+        assertOnlyUserQueryHighlighted(solrTestRule.getSolrClient().query(params));
+      }
+    }
+  }
+
+  @Test
+  public void testImplicitQueryUsesMainParser() throws Exception {
+    ModifiableSolrParams params = boostedQuery(false);
+    params.remove("q");
+    params.set("q.alt", "{!lucene}body_t:fox OR title_t:fox");
+    assertOnlyUserQueryHighlighted(solrTestRule.getSolrClient().query(params));
+
+    params = boostedQuery(false);
+    params.remove("defType");
+    params.remove("qf");
+    params.remove("bq");
+    params.set("q", "{!edismax qf='body_t title_t' bq='body_t:cats'}fox");
+    assertOnlyUserQueryHighlighted(solrTestRule.getSolrClient().query(params));
+  }
+
+  @Test
+  public void testExplicitHighlightQueryOverridesMainQuery() throws Exception {
+    for (boolean weightMatches : List.of(true, false)) {
+      ModifiableSolrParams params = boostedQuery(weightMatches);
+      params.set("hl.q", "body_t:cats");
+      List<SolrDocument> docs = solrTestRule.getSolrClient().query(params).getResults();
+      assertEquals(2, docs.size());
+      assertFalse(docs.getFirst().containsKey("body_hl"));
+      assertContains("<em>cats</em>", docs.get(1).getFieldValue("body_hl"));
+
+      params.set("hl.q", "fox");
+      params.set("fl", "id,body_hl:[hl f=body_t q=body_t:cats]");
+      docs = solrTestRule.getSolrClient().query(params).getResults();
+      assertEquals(2, docs.size());
+      assertFalse(docs.getFirst().containsKey("body_hl"));
+      assertContains("<em>cats</em>", docs.get(1).getFieldValue("body_hl"));
+    }
+  }
+
   @Test
   public void testRealTimeGet() throws Exception {
     // no query, so the original value passes through
