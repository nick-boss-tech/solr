+  @Test
+  public void testReview5126RtgExamples() throws Exception {
+    // Slice R diagnostic for PR 5126: what does [hl] return for /get when the
+    // document is uncommitted? No query is used anywhere, so the fallback
+    // (original value passes through) is what is exercised. Transformed
+    // results in phases 2 and 3 are observations, printed before any
+    // assertion about them; only the plain-get and /select controls are
+    // asserted, and only when the /select control proves the phase is
+    // genuinely uncommitted for the active searcher.
+    SolrClient client = solrTestRule.getSolrClient();
+    final String existingId = "rtg-existing-5126";
+    final String newId = "rtg-new-5126";
+    final String originalText = "Original stored text.";
+    final String freshText = "Fresh update text.";
+    final String insertText = "Uncommitted insert text.";
+    try {
+      // Phase 1: committed control.
+      SolrInputDocument doc = new SolrInputDocument();
+      doc.addField("id", existingId);
+      doc.addField("body_t", originalText);
+      client.add(doc);
+      client.commit();
+      SolrDocument plain = getByIdFl(client, existingId, "id,body_t");
+      SolrDocument transformed = getByIdFl(client, existingId, "id,body_t:[hl]");
+      System.out.println(
+          "PR5126_RTG phase=1-committed plain=" + plain + " transformed=" + transformed);
+      assertEquals(originalText, plain.getFieldValue("body_t"));
+      assertEquals(originalText, transformed.getFieldValue("body_t"));
+
+      // Phase 2: full replace without commit.
+      SolrInputDocument replacement = new SolrInputDocument();
+      replacement.addField("id", existingId);
+      replacement.addField("body_t", freshText);
+      client.add(replacement);
+      SolrDocument selectDoc = selectById(client, existingId);
+      boolean phase2Discriminating =
+          selectDoc != null && originalText.equals(selectDoc.getFieldValue("body_t"));
+      SolrDocument plain2 = getByIdFl(client, existingId, "id,body_t");
+      String transformed2 = getByIdFlLenient(client, existingId, "id,body_t:[hl]");
+      System.out.println(
+          "PR5126_RTG phase=2-replaced-uncommitted discriminating="
+              + phase2Discriminating
+              + " select="
+              + selectDoc
+              + " plain="
+              + plain2
+              + " transformed="
+              + transformed2);
+      if (phase2Discriminating) {
+        assertEquals(freshText, plain2.getFieldValue("body_t"));
+      } else {
+        System.out.println(
+            "PR5126_RTG phase=2 NON-DISCRIMINATING: searcher already sees the replacement");
+      }
+
+      // Phase 3: brand-new document without commit.
+      SolrInputDocument inserted = new SolrInputDocument();
+      inserted.addField("id", newId);
+      inserted.addField("body_t", insertText);
+      client.add(inserted);
+      SolrDocument selectNew = selectById(client, newId);
+      boolean phase3Discriminating = selectNew == null;
+      SolrDocument plain3 = getByIdFl(client, newId, "id,body_t");
+      String transformed3 = getByIdFlLenient(client, newId, "id,body_t:[hl]");
+      System.out.println(
+          "PR5126_RTG phase=3-inserted-uncommitted discriminating="
+              + phase3Discriminating
+              + " select="
+              + selectNew
+              + " plain="
+              + plain3
+              + " transformed="
+              + transformed3);
+      if (phase3Discriminating) {
+        assertEquals(insertText, plain3.getFieldValue("body_t"));
+      } else {
+        System.out.println(
+            "PR5126_RTG phase=3 NON-DISCRIMINATING: searcher already sees the insert");
+      }
+
+      // Phase 4: post-commit control.
+      client.commit();
+      SolrDocument plain4 = getByIdFl(client, existingId, "id,body_t");
+      SolrDocument transformed4 = getByIdFl(client, existingId, "id,body_t:[hl]");
+      SolrDocument plain4New = getByIdFl(client, newId, "id,body_t");
+      SolrDocument transformed4New = getByIdFl(client, newId, "id,body_t:[hl]");
+      System.out.println(
+          "PR5126_RTG phase=4-committed plain="
+              + plain4
+              + " transformed="
+              + transformed4
+              + " plainNew="
+              + plain4New
+              + " transformedNew="
+              + transformed4New);
+      assertEquals(freshText, plain4.getFieldValue("body_t"));
+      assertEquals(freshText, transformed4.getFieldValue("body_t"));
+      assertEquals(insertText, plain4New.getFieldValue("body_t"));
+      assertEquals(insertText, transformed4New.getFieldValue("body_t"));
+    } finally {
+      client.deleteById(existingId);
+      client.deleteById(newId);
+      client.commit();
+    }
+  }
+
+  private static SolrDocument getByIdFl(SolrClient client, String id, String fl) throws Exception {
+    ModifiableSolrParams params = new ModifiableSolrParams();
+    params.set("fl", fl);
+    return client.getById(id, params);
+  }
+
+  private static String getByIdFlLenient(SolrClient client, String id, String fl) {
+    try {
+      SolrDocument doc = getByIdFl(client, id, fl);
+      return doc == null ? "null-document" : String.valueOf(doc);
+    } catch (Exception e) {
+      return "THREW " + e.getClass().getSimpleName() + ": " + e.getMessage();
+    }
+  }
+
+  private static SolrDocument selectById(SolrClient client, String id) throws Exception {
+    SolrQuery query = new SolrQuery("id:" + id);
+    query.setFields("id,body_t");
+    List<SolrDocument> docs = client.query(query).getResults();
+    return docs.isEmpty() ? null : docs.getFirst();
+  }
