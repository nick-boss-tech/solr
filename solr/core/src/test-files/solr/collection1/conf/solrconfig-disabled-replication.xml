<!-- Replication handlers that are explicitly disabled (or not configured) in solrconfig.xml. -->

<config>

  <dataDir>${solr.data.dir:}</dataDir>

  <directoryFactory name="DirectoryFactory"
                    class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}"/>
  <schemaFactory class="ClassicIndexSchemaFactory"/>

  <luceneMatchVersion>${tests.luceneMatchVersion:LATEST}</luceneMatchVersion>

  <xi:include href="solrconfig.snippet.randomindexconfig.xml" xmlns:xi="http://www.w3.org/2001/XInclude"/>

  <updateHandler class="solr.DirectUpdateHandler2"/>

  <requestHandler name="/select" class="solr.SearchHandler"/>

  <!-- leader section present but disabled -->
  <requestHandler name="/replication-disabled-leader" class="solr.ReplicationHandler">
    <lst name="leader">
      <str name="enable">false</str>
      <str name="replicateAfter">commit</str>
    </lst>
  </requestHandler>

  <!-- both sections present and disabled -->
  <requestHandler name="/replication-disabled-both" class="solr.ReplicationHandler">
    <lst name="leader">
      <str name="enable">false</str>
    </lst>
    <lst name="follower">
      <str name="enable">false</str>
      <str name="leaderUrl">http://127.0.0.1:1/solr/collection1</str>
      <str name="pollInterval">00:00:01</str>
    </lst>
  </requestHandler>

  <!-- nothing configured: replication stays on (leader on commit) -->
  <requestHandler name="/replication-default" class="solr.ReplicationHandler"/>

  <!-- leader section present and enabled -->
  <requestHandler name="/replication-enabled-leader" class="solr.ReplicationHandler">
    <lst name="leader">
      <str name="replicateAfter">commit</str>
    </lst>
  </requestHandler>

</config>
